{{#each @options as |option i|}}
  <RadioButton
    @name={{(concat 'radio-slider-option-' this.elementId '-' i)}}
    @checked={{@selected}}
    @value={{option.value}}
    class='field'
    id={{(concat 'radio-slider-option-' this.elementId '-' i)}}
  />
  <label
    for='{{concat "radio-slider-option-" this.elementId "-" i}}'
  >{{option.label}}</label>
{{/each}}