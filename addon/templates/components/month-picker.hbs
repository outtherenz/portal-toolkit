{{#if @compact}}
  <label class='month-picker__input-label' for='month-picker__input'>
    <span class='month-picker__display'>
      <span class='month-picker__month'>{{moment-format
          @period
          'MMM'
          'YYYY-MM'
        }}</span>
      <span class='month-picker__year'>{{moment-format
          @period
          'YYYY'
          'YYYY-MM'
        }}</span>
    </span>
    <FaIcon @icon='calendar' />
  </label>

  <Input
    @type='month'
    @value={{@period}}
    class='month-picker__input'
    id='month-picker__input'
  />
{{else}}
  <button class='subdued' type="button" {{action 'prevYear'}}>«</button>
  <button class='subdued' type="button" {{action 'prevMonth'}}>‹</button>

  <div class='inputs'>
    <select
      class={{if
        this.dark
        'select-box select-box--dark month'
        'select-box month'
      }}
      onchange={{action 'onChangeMonth'}}
    >
      <option value='01' selected={{eq this.selectedMonth '01'}}>
        January
      </option>
      <option value='02' selected={{eq this.selectedMonth '02'}}>
        February
      </option>
      <option value='03' selected={{eq this.selectedMonth '03'}}>
        March
      </option>
      <option value='04' selected={{eq this.selectedMonth '04'}}>
        April
      </option>
      <option value='05' selected={{eq this.selectedMonth '05'}}>
        May
      </option>
      <option value='06' selected={{eq this.selectedMonth '06'}}>
        June
      </option>
      <option value='07' selected={{eq this.selectedMonth '07'}}>
        July
      </option>
      <option value='08' selected={{eq this.selectedMonth '08'}}>
        August
      </option>
      <option value='09' selected={{eq this.selectedMonth '09'}}>
        September
      </option>
      <option value='10' selected={{eq this.selectedMonth '10'}}>
        October
      </option>
      <option value='11' selected={{eq this.selectedMonth '11'}}>
        November
      </option>
      <option value='12' selected={{eq this.selectedMonth '12'}}>
        December
      </option>
    </select>

    <select
      class={{if
        this.dark
        'select-box select-box--dark year'
        'select-box year'
      }}
      onchange={{action 'onChangeYear'}}
    >
      {{#each this.yearList as |year|}}
        <option value={{year}} selected={{eq this.selectedYear year}}>
          {{year}}
        </option>
      {{/each}}
    </select>
  </div>

  <button class='subdued' type="button" {{action 'nextMonth'}}>›</button>
  <button class='subdued' type="button" {{action 'nextYear'}}>»</button>
{{/if}}