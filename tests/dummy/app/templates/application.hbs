<header class='toolkit-header'>
  <h1>Portal Toolkit</h1>
  <h2>Code to be shared across the Portal’s modules.</h2>
</header>
<main>
  <aside class='sidebar'>
    <nav>
      <h3>Components</h3>
      <ul>
        <li><LinkTo @route='app-components.active-table'>Active table</LinkTo></li>
        <li><LinkTo @route='app-components.charts'>Charts</LinkTo></li>
        <li><LinkTo @route='app-components.checkbox-list'>Checkbox list</LinkTo></li>
        <li><LinkTo @route='app-components.date-input'>Date input</LinkTo></li>
        <li><LinkTo @route='app-components.date-picker'>Date picker</LinkTo></li>
        <li><LinkTo @route='app-components.file-inputs'>File inputs</LinkTo></li>
        <li><LinkTo @route='app-components.formatted-input'>Formatted input</LinkTo></li>
        <li><LinkTo @route='app-components.loading-button'>Loading button</LinkTo></li>
        <li><LinkTo @route='app-components.loading-icon'>Loading icon</LinkTo></li>
        <li><LinkTo @route='app-components.month-picker'>Month picker</LinkTo></li>
        <li><LinkTo @route='app-components.overlaid-dropdown'>Overlaid Dropdown</LinkTo></li>
        <li><LinkTo @route='app-components.print-button'>Print button</LinkTo></li>
        <li><LinkTo @route='app-components.radio-slider'>Radio Slider</LinkTo></li>
        <li><LinkTo @route='app-components.sortable-list'>Sortable list</LinkTo></li>
        <li><LinkTo @route='app-components.modal-dialog'>Modal dialog</LinkTo></li>
        <li><LinkTo @route='app-components.value-change-indicator'>Value Change Indicator</LinkTo></li>
        <li><LinkTo @route='app-components.combo-box'>Combo box</LinkTo></li>
        <li><LinkTo @route='app-components.combo-button'>Combo button</LinkTo></li>
        <li><LinkTo @route='app-components.search-select'>Search select</LinkTo></li>
      </ul>

      <h3>Helpers</h3>
      <ul>
        <li><LinkTo  @route='helpers.concat'>Concat</LinkTo></li>
        <li><LinkTo  @route='helpers.format-number'>Format number</LinkTo></li>
        <li><LinkTo  @route='helpers.math'>Math</LinkTo></li>
      </ul>

      <h3>Services</h3>
      <ul>
        <li><LinkTo @route='services.notifications'>Notifications</LinkTo></li>
      </ul>
    </nav>
  </aside>

  <article class='toolkit-page'>
    {{outlet}}
  </article>
</main>
{{notification-container notifications=this.notifications}}
